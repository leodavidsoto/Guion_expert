# ============================================================
# Guion_expert — Configuración de LLM
# ============================================================
# Copia este archivo a .env y reemplaza los valores.
# NUNCA commitees .env (ya está en .gitignore).

# --- Provider activo ---------------------------------------------------------
# Opciones: claude (default) | ollama
LLM_PROVIDER=claude

# --- Claude (Anthropic API) --------------------------------------------------
# Obtené tu key en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REEMPLAZAR_CON_TU_KEY_AQUI

# Modelo default (Haiku 4.5 = rápido + barato + más capaz)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Parámetros de generación
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# --- Ollama (fallback opcional) ---------------------------------------------
# Solo se usa si LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
