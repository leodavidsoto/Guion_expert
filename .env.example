# ============================================================
# Guion_expert — Variables de entorno
# ============================================================
# Copia este archivo a .env y reemplaza los valores.
# NUNCA commitees .env (ya está en .gitignore).
#
# Las variables marcadas con [REQUIRED] hacen crashear el server al boot
# si faltan (fail-fast via pydantic-settings). El resto tiene defaults
# seguros en webapp/config.py.

# ──────────────────────────────────────────────────────────────────────
# 1. LLM Provider — Anthropic (default) / Ollama (fallback)
# ──────────────────────────────────────────────────────────────────────

# Provider activo. Opciones: claude | ollama
LLM_PROVIDER=claude

# [REQUIRED] Anthropic API key. Obtenela en:
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REEMPLAZAR_CON_TU_KEY_AQUI

# Modelo default (Haiku 4.5 = rápido + barato + más capaz de Haiku).
# Alternativas: claude-sonnet-4-6, claude-opus-4-6
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Parámetros globales (por-expert override en config/llm_provider.yaml).
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# Ollama (solo si LLM_PROVIDER=ollama).
OLLAMA_HOST=http://localhost:11434

# ──────────────────────────────────────────────────────────────────────
# 2. Servidor Flask / SocketIO
# ──────────────────────────────────────────────────────────────────────

# Host/port del server. 0.0.0.0 = escucha en todas las interfaces.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=5000

# Secret key para sesiones Flask. Generá uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REEMPLAZAR_CON_TOKEN_HEX_DE_32_BYTES

# Nivel de log. Opciones: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────
# 3. fal.ai — FLUX / Kling / Runway / WAN / Real-ESRGAN / mmaudio / TTS
# ──────────────────────────────────────────────────────────────────────
# Una sola key para todos los modelos. Obtenela en:
#   https://fal.ai/dashboard/keys
#
# Usada por webapp/integrations/fal.py (Commit 9). Formato:
#   fal_api_key="key_id:key_secret"

FAL_API_KEY=REEMPLAZAR_CON_TU_KEY_FAL

# Base URL (raramente cambia).
FAL_BASE_URL=https://queue.fal.run

# Trigger word para el LoRA de identidad (FLUX.1 Pro LoRA training).
# Si entrenás tu propia banda/personaje, cambiá esto.
FLUX_LORA_TRIGGER=3SM_BAND

# URL del .safetensors entrenado (se completa después del primer train).
# Podés dejarlo vacío; asset_generator.py (Commit 11) lo rellena solo.
FLUX_LORA_URL=

# Defaults de FLUX
FLUX_MODEL=fal-ai/flux-lora
FLUX_STEPS=28
FLUX_GUIDANCE=3.5
FLUX_IMAGE_SIZE=portrait_16_9   # 1080x1920 para reels

# Defaults I2V (routing real en VIDEO_MODEL_ROUTING; esto es fallback).
I2V_DEFAULT_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
I2V_DEFAULT_DURATION_S=5

# Real-ESRGAN / RIFE (post-producción)
REAL_ESRGAN_SCALE=2
RIFE_TARGET_FPS=60

# ──────────────────────────────────────────────────────────────────────
# 4. Suno — música original (self-hosted via gcui-art/suno-api)
# ──────────────────────────────────────────────────────────────────────
# Leo paga Suno Premium. La cookie se pasa como env var al contenedor
# suno-api (ver docker-compose.yml, Commit 10).
#
# Cómo obtener la cookie:
#   1. Login a suno.com con tu cuenta Premium.
#   2. DevTools → Application → Cookies → suno.com.
#   3. Copiá TODAS las cookies como un solo string (name=value; name=value).
#
# Más info: https://github.com/gcui-art/suno-api

SUNO_COOKIE=REEMPLAZAR_CON_TU_COOKIE_DE_SUNO
SUNO_API_URL=http://suno-api:3000
SUNO_MODEL=chirp-v3-5            # chirp-v3-5 = mejor calidad

# ──────────────────────────────────────────────────────────────────────
# 5. OpenMontage bridge
# ──────────────────────────────────────────────────────────────────────
# Donde vive el repo OpenMontage en disco. El bridge exporta scene_plan
# a <OPENMONTAGE_ROOT>/projects/<project_id>/stages/.

OPENMONTAGE_ROOT=/app/openmontage

# ──────────────────────────────────────────────────────────────────────
# 6. HTTP client (integrations/base.py)
# ──────────────────────────────────────────────────────────────────────
# Timeouts y retries compartidos por todos los integrations.

HTTP_TIMEOUT_CONNECT=10.0        # segundos — timeout al abrir conexión
HTTP_TIMEOUT_READ=300.0          # segundos — timeout leyendo response (I2V tarda)
HTTP_MAX_RETRIES=3               # reintentos en 5xx/429 con backoff exponencial
HTTP_BACKOFF_BASE=1.5            # segundos — base del backoff (1.5, 2.25, 3.38)

# ──────────────────────────────────────────────────────────────────────
# 7. Observability (opcional)
# ──────────────────────────────────────────────────────────────────────
# Para logs estructurados JSON. Si lo pusheás a un colector (Loki/Datadog),
# configurá la URL acá. Si queda vacío, los logs van a stdout.

LOG_FORMAT=json                  # json | console (dev)
SENTRY_DSN=                      # opcional — error tracking

# ──────────────────────────────────────────────────────────────────────
# 8. Límites de pipeline (protección)
# ──────────────────────────────────────────────────────────────────────
# Máx escenas por proyecto (evita runs accidentales costosos).
MAX_SCENES_PER_PROJECT=30

# Budget tope en USD por proyecto. asset_generator.py (Commit 11) aborta si
# supera este número antes de terminar.
MAX_BUDGET_USD=5.00
